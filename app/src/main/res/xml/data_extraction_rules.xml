<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules for API 31+. Mirrors backup_rules.xml (used on API 30 and below).

   cloud-backup   → Google Drive backup, restored when the app is reinstalled or set up on a new
                    device. This is what makes the free trial survive an uninstall: "rota_prefs"
                    carries trial_start_millis, so reinstalling does not hand out a second 7 days.
   device-transfer → direct old-phone → new-phone copy; same content.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
