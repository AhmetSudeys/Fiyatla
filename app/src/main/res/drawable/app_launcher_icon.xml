<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer frame -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_white" />
            <stroke
                android:width="1dp"
                android:color="@color/brand_blue" />
        </shape>
    </item>

    <!-- Inner logo (slight inset so it never gets clipped by launcher masks) -->
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <bitmap
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/logo" />
    </item>

</layer-list>


