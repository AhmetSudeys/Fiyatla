<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:padding="@dimen/space_m"
    tools:context="com.ahmetsudeys.dogalgazteklif.ui.ledger.LedgerFragment">

    <!--
        Başlık Toolbar'ın kendi `app:title`'ı değil, autosize'lı bir alt görünüm: Toolbar başlığı
        küçülemediği için dar cihazlarda "Alacak Defteri" sağdaki Defter/Rapor segmentine
        çarpıp "Alacak Def..." diye kesiliyordu.
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toStartOf="@id/toggle_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back">

        <TextView
            android:id="@+id/text_toolbar_title"
            style="@style/Widget.Rota.AutoSizeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:text="@string/ledger_title" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Defter | Rapor segmented switch, top-right -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_book"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="@string/ledger_tab_book"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:icon="@drawable/ic_nav_customers"
            app:iconPadding="4dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="@string/ledger_tab_report"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:iconPadding="4dp"
            app:iconSize="16dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Searchable customer select -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:hint="@string/ledger_search_hint"
        app:boxStrokeColor="@color/accent_blue"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/accent_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/auto_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Vivid summary cards -->
    <LinearLayout
        android:id="@+id/row_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/input_search">

        <!-- All three cards stretch to the tallest one (match_parent inside a horizontal
             LinearLayout), and each amount is pushed to the card's bottom by the Space below its
             label. Otherwise a label that wraps to two lines ("Toplam Tahsil Edilen") pushes its
             amount lower than the neighbours' and the row reads as misaligned. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_blue"
                android:minHeight="90dp"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ledger_total_agreed"
                    android:textColor="@color/white_85"
                    android:textSize="11sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/text_total_agreed"
                    style="@style/Widget.Rota.AutoSizeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    tools:text="₺ 120.000" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_green"
                android:minHeight="90dp"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ledger_total_collected"
                    android:textColor="@color/white_85"
                    android:textSize="11sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/text_total_collected"
                    style="@style/Widget.Rota.AutoSizeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    tools:text="₺ 70.000" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_red"
                android:minHeight="90dp"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ledger_total_remaining"
                    android:textColor="@color/white_85"
                    android:textSize="11sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/text_total_remaining"
                    style="@style/Widget.Rota.AutoSizeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    tools:text="₺ 50.000" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/row_summary">

        <!-- Defter view -->
        <LinearLayout
            android:id="@+id/view_book"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="@dimen/space_s">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/ledger_filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_debtors"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ledger_filter_debtors" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_paid"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ledger_filter_paid" />
            </com.google.android.material.chip.ChipGroup>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/space_s">

                <TextView
                    android:id="@+id/text_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:padding="@dimen/space_m"
                    android:text="@string/ledger_no_customers"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_ledger"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="@dimen/space_m"
                    tools:listitem="@layout/item_ledger_row" />
            </FrameLayout>
        </LinearLayout>

        <!-- Rapor view -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/view_report"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_l">

                <!-- Aylık ciro -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rota.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_pill_fill"
                                android:backgroundTint="@color/accent_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:text="@string/report_monthly_revenue"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_months"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:chipSpacingHorizontal="@dimen/space_xs" />

                        <com.ahmetsudeys.dogalgazteklif.ui.ledger.ColumnChartView
                            android:id="@+id/chart_monthly"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="@dimen/space_s" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:background="@drawable/bg_soft_tile"
                            android:orientation="vertical"
                            android:padding="@dimen/space_m">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:text="@string/report_month_ciro"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/text_month_ciro"
                                style="@style/Widget.Rota.AutoSizeAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/accent_blue"
                                app:autoSizeMaxTextSize="22sp"
                                app:autoSizeMinTextSize="14sp"
                                tools:text="₺ 42.000" />

                            <!--
                                Nakit / Kredi Kartı / Havale eskiden tek satırda 3 eşit sütundu;
                                rakamlar büyüdükçe etiketlerle iç içe giriyor ve kesiliyordu.
                                Artık ALT ALTA: solda sabit etiket, sağda tutar (autosize).
                                Hangi rakam yazarsa yazsın taşma/çakışma olmaz.
                            -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- bg_dot'un <size>'i yok; TextView bilesik cizimi olarak 0x0 ciziliyordu,
                                     bu yuzden nokta ayri bir View olarak veriliyor. -->
                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_dot"
                                    android:backgroundTint="@color/accent_green" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/payment_method_cash"
                                    android:textColor="@color/accent_green"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/text_month_cash"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_s"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:maxLines="1"
                                    android:textColor="@color/accent_green"
                                    android:textStyle="bold"
                                    app:autoSizeMaxTextSize="15sp"
                                    app:autoSizeMinTextSize="10sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- bg_dot'un <size>'i yok; TextView bilesik cizimi olarak 0x0 ciziliyordu,
                                     bu yuzden nokta ayri bir View olarak veriliyor. -->
                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_dot"
                                    android:backgroundTint="@color/accent_blue" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/payment_method_card"
                                    android:textColor="@color/accent_blue"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/text_month_card"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_s"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:maxLines="1"
                                    android:textColor="@color/accent_blue"
                                    android:textStyle="bold"
                                    app:autoSizeMaxTextSize="15sp"
                                    app:autoSizeMinTextSize="10sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- bg_dot'un <size>'i yok; TextView bilesik cizimi olarak 0x0 ciziliyordu,
                                     bu yuzden nokta ayri bir View olarak veriliyor. -->
                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_dot"
                                    android:backgroundTint="@color/accent_amber" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/payment_method_transfer"
                                    android:textColor="@color/accent_amber"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/text_month_transfer"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_s"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:maxLines="1"
                                    android:textColor="@color/accent_amber"
                                    android:textStyle="bold"
                                    app:autoSizeMaxTextSize="15sp"
                                    app:autoSizeMinTextSize="10sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ödeme yöntemi dağılımı -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rota.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_pill_fill"
                                android:backgroundTint="@color/accent_purple" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:text="@string/report_method_breakdown"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_method_month_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.55"
                            android:textSize="11sp"
                            tools:text="Seçilen ay: Mayıs 2026" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.ahmetsudeys.dogalgazteklif.ui.ledger.DonutChartView
                                android:id="@+id/chart_methods"
                                android:layout_width="130dp"
                                android:layout_height="130dp" />

                            <LinearLayout
                                android:id="@+id/container_method_legend"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/space_m"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Genel durum -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rota.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_pill_fill"
                                android:backgroundTint="@color/accent_teal" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:text="@string/report_overview"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_overview_month_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.55"
                            android:textSize="11sp"
                            tools:text="Seçilen ay: Mayıs 2026" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_soft_tile"
                                android:orientation="vertical"
                                android:padding="@dimen/space_s">

                                <TextView
                                    android:id="@+id/text_stat_collected"
                                    style="@style/Widget.Rota.AutoSizeAmount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/accent_green"
                                    tools:text="₺ 42.000" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.6"
                                    android:text="@string/report_stat_collected"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/space_xs"
                                android:background="@drawable/bg_soft_tile"
                                android:orientation="vertical"
                                android:padding="@dimen/space_s">

                                <TextView
                                    android:id="@+id/text_stat_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/accent_blue"
                                    android:textStyle="bold"
                                    android:textSize="20sp"
                                    tools:text="8" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.6"
                                    android:text="@string/report_stat_count"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_soft_tile"
                                android:orientation="vertical"
                                android:padding="@dimen/space_s">

                                <TextView
                                    android:id="@+id/text_stat_payers"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/accent_teal"
                                    android:textStyle="bold"
                                    android:textSize="20sp"
                                    tools:text="4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.6"
                                    android:text="@string/report_stat_payers"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/space_xs"
                                android:background="@drawable/bg_soft_tile"
                                android:orientation="vertical"
                                android:padding="@dimen/space_s">

                                <TextView
                                    android:id="@+id/text_stat_avg"
                                    style="@style/Widget.Rota.AutoSizeAmount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/accent_purple"
                                    tools:text="₺ 5.250" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.6"
                                    android:text="@string/report_stat_avg"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- En çok borçlular -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rota.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_pill_fill"
                                android:backgroundTint="@color/accent_red" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:text="@string/report_top_debtors"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/container_debtors"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
