<?xml version="1.0" encoding="utf-8"?>
<!--
    Teklif satırı (Anasayfa "Son 5 teklif" + Tekliflerim).

    Müşteri adı ARTIK KESİLMEZ: durum hapı ("Beklemede/Onaylandı/Reddedildi") ad satırından
    alınıp kartın alt satırına (tutarın soluna) taşındı. Böylece ad kartın tam genişliğini
    kullanır, uzun adlarda alt satıra sarar ve maxLines/ellipsize verilmediği için her zaman
    tam görünür. Tek kısıtlayıcı, yalnızca "Tekliflerim" ekranında görünen 24dp'lik çöp
    kutusu ikonudur; o da gizliyken goneMarginEnd ile yer kaplamaz.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    style="@style/Widget.Rota.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_xs">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_s">

        <View
            android:id="@+id/view_status_bar"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@color/warning_amber"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/image_eye"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_s"
            android:contentDescription="@null"
            app:layout_constraintStart_toEndOf="@id/view_status_bar"
            app:layout_constraintTop_toTopOf="@id/text_customer"
            app:srcCompat="@drawable/ic_eye" />

        <ImageView
            android:id="@+id/image_delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_customer"
            app:srcCompat="@drawable/ic_trash"
            tools:visibility="visible" />

        <!-- Ad: sınırsız satır, ellipsize yok -> her uzunlukta tam görünür. -->
        <TextView
            android:id="@+id/text_customer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_xs"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/image_delete"
            app:layout_constraintStart_toEndOf="@id/image_eye"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp"
            tools:text="Ahmet Mehmet Çok Uzun Müşteri Adı Soyadı" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="text_customer,image_eye,image_delete" />

        <TextView
            android:id="@+id/text_operations"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/text_customer"
            app:layout_constraintTop_toBottomOf="@id/barrier_header"
            tools:text="Kazan Full, Gaz Tesisatı" />

        <TextView
            android:id="@+id/text_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.8"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/brand_blue"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/text_operations"
            app:layout_constraintTop_toBottomOf="@id/text_operations"
            tools:text="Not: Pazartesi aranacak" />

        <!-- Alt satır: durum hapı (solda) + tutar (sağda). -->
        <LinearLayout
            android:id="@+id/layout_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/warning_amber_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="5dp"
            app:layout_constraintStart_toStartOf="@id/text_operations"
            app:layout_constraintTop_toBottomOf="@id/text_note">

            <ImageView
                android:id="@+id/image_status"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_status_pending"
                app:tint="@color/warning_amber" />

            <TextView
                android:id="@+id/text_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:text="@string/status_pending"
                android:textColor="@color/warning_amber"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_caret"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_caret_down"
                app:tint="@color/warning_amber" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_total"
            style="@style/Widget.Rota.AutoSizeAmount"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/space_s"
            android:gravity="end|center_vertical"
            android:textColor="@color/brand_red"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/layout_status"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layout_status"
            app:layout_constraintTop_toTopOf="@id/layout_status"
            tools:text="₺ 38.700,00" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
