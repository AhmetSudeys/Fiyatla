<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:padding="@dimen/space_l"
    tools:context="com.ahmetsudeys.dogalgazteklif.ui.quotes.QuoteDetailFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/quote_detail_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layout_marginBottom="@dimen/space_m"
        app:layout_constraintBottom_toTopOf="@id/button_add_customer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card"
                style="@style/Widget.Rota.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_m">

                    <LinearLayout
                        android:id="@+id/layout_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_pill"
                        android:backgroundTint="@color/warning_amber_soft"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/image_status"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_status_pending"
                            app:tint="@color/warning_amber" />

                        <TextView
                            android:id="@+id/text_status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:singleLine="true"
                            android:text="@string/status_pending"
                            android:textColor="@color/warning_amber"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/image_caret"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="3dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_caret_down"
                            app:tint="@color/warning_amber" />
                    </LinearLayout>

                    <!-- Ad kesilmesin: maxLines/ellipsize YOK, uzun adlar alt satıra sarar. -->
                    <TextView
                        android:id="@+id/text_customer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/layout_status"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Müşteri: Ahmet Mehmet Çok Uzun Müşteri Adı Soyadı" />

                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/barrier_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="text_customer,layout_status" />

                    <TextView
                        android:id="@+id/text_operations"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:alpha="0.8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/barrier_header"
                        tools:text="İşlemler: Kazan Full, Full" />

                    <View
                        android:id="@+id/divider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_m"
                        android:background="@color/outline_light"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_operations" />

                    <TextView
                        android:id="@+id/text_materials_total_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:maxLines="1"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        android:text="@string/materials_total"
                        app:layout_constraintEnd_toStartOf="@id/text_materials_total_value"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintTop_toBottomOf="@id/divider" />

                    <TextView
                        android:id="@+id/text_materials_total_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/text_materials_total_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="₺ 26.700,00" />

                    <TextView
                        android:id="@+id/text_labor_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:maxLines="1"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        android:text="@string/labor_total"
                        app:layout_constraintEnd_toStartOf="@id/text_labor_value"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintTop_toBottomOf="@id/text_materials_total_label" />

                    <TextView
                        android:id="@+id/text_labor_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/text_labor_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="₺ 10.000,00" />

                    <TextView
                        android:id="@+id/text_radiator_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:maxLines="1"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        android:text="@string/radiator_total"
                        app:layout_constraintEnd_toStartOf="@id/text_radiator_value"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintTop_toBottomOf="@id/text_labor_label" />

                    <TextView
                        android:id="@+id/text_radiator_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/text_radiator_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="₺ 0,00" />

                    <TextView
                        android:id="@+id/text_boiler_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:maxLines="1"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        android:text="@string/boiler_price"
                        app:layout_constraintEnd_toStartOf="@id/text_boiler_value"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintTop_toBottomOf="@id/text_radiator_label" />

                    <TextView
                        android:id="@+id/text_boiler_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/text_boiler_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="₺ 0,00" />

                    <TextView
                        android:id="@+id/text_profit_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:maxLines="1"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        android:text="@string/profit"
                        app:layout_constraintEnd_toStartOf="@id/text_profit_value"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintTop_toBottomOf="@id/text_boiler_label" />

                    <TextView
                        android:id="@+id/text_profit_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/text_profit_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="₺ 2.000,00" />

                    <TextView
                        android:id="@+id/text_discount_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:maxLines="1"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        android:text="@string/discount"
                        android:visibility="gone"
                        app:layout_constraintEnd_toStartOf="@id/text_discount_value"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintTop_toBottomOf="@id/text_profit_label" />

                    <TextView
                        android:id="@+id/text_discount_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/error_red"
                        android:visibility="gone"
                        app:layout_constraintBaseline_toBaselineOf="@id/text_discount_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="- ₺ 500,00" />

                    <View
                        android:id="@+id/divider_total"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_m"
                        android:background="@color/outline_light"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_discount_label" />

                    <TextView
                        android:id="@+id/text_grand_total_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:maxLines="1"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        android:text="@string/grand_total"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/text_grand_total_value"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintTop_toBottomOf="@id/divider_total" />

                    <TextView
                        android:id="@+id/text_grand_total_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/brand_red"
                        app:layout_constraintBaseline_toBaselineOf="@id/text_grand_total_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="₺ 38.700,00" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_add_customer"
        style="@style/Widget.Rota.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_m"
        android:minHeight="52dp"
        android:text="@string/add_as_customer"
        app:icon="@drawable/ic_nav_customers"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/button_delete_quote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_delete_quote"
        style="@style/Widget.Rota.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="@string/delete_quote"
        android:textColor="@color/error_red"
        app:icon="@drawable/ic_trash"
        app:iconGravity="textStart"
        app:iconTint="@color/error_red"
        app:strokeColor="@color/error_red"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


