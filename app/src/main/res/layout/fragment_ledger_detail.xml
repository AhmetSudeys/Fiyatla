<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:padding="@dimen/space_m"
    tools:context="com.ahmetsudeys.dogalgazteklif.ui.ledger.LedgerDetailFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/ledger_detail_title" />

    <!-- Header summary card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_header"
        style="@style/Widget.Rota.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_m">

            <TextView
                android:id="@+id/text_name"
                style="@style/Widget.Rota.AutoSizeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/badge_status"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Ahmet Soylu" />

            <TextView
                android:id="@+id/badge_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/success_green_soft"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/success_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Ödendi"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:drawablePadding="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_phone"
                app:drawableTint="@color/accent_blue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_name"
                tools:text="0555 111 22 33" />

            <TextView
                android:id="@+id/text_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:drawablePadding="6dp"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/accent_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_phone"
                tools:text="Anlaşılan tarih: 12.05.2026" />

            <TextView
                android:id="@+id/text_due"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:drawablePadding="6dp"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/accent_amber"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_date"
                tools:text="Alacak vadesi: 12.06.2026" />

            <LinearLayout
                android:id="@+id/layout_amounts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal"
                android:weightSum="3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_due">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:text="@string/ledger_agreed"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/text_agreed"
                        style="@style/Widget.Rota.AutoSizeAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeMinTextSize="10sp"
                        tools:text="₺ 38.700" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:text="@string/ledger_collected"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/text_collected"
                        style="@style/Widget.Rota.AutoSizeAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/success_green"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeMinTextSize="10sp"
                        tools:text="₺ 20.000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:text="@string/ledger_remaining"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/text_remaining"
                        style="@style/Widget.Rota.AutoSizeAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/error_red"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeMinTextSize="10sp"
                        tools:text="₺ 18.700" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit_agreement"
                style="@style/Widget.Rota.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/ledger_edit_agreement"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconTint="@color/brand_blue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_amounts" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/text_payments_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/ledger_payments_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_header" />

    <TextView
        android:id="@+id/text_payments_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:alpha="0.55"
        android:text="@string/ledger_payments_hint"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/text_payments_title"
        app:layout_constraintStart_toEndOf="@id/text_payments_title" />

    <TextView
        android:id="@+id/text_archived"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="6dp"
        android:textColor="@color/accent_green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_wallet"
        app:drawableTint="@color/accent_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_payments_title"
        tools:text="Önceki dönem tahsilatı (özet): ₺ 12.000"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_empty_payments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:alpha="0.7"
        android:gravity="center"
        android:text="@string/ledger_no_payments"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_archived" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_payments"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_s"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_s"
        app:layout_constraintBottom_toTopOf="@id/button_add_payment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_archived"
        tools:listitem="@layout/item_payment_row" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_add_payment"
        style="@style/Widget.Rota.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ledger_add_payment"
        app:icon="@drawable/ic_plus"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
