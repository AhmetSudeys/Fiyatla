<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    style="@style/Widget.Rota.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    android:theme="@style/ThemeOverlay.Rota.PlainSurface"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_m">

        <View
            android:id="@+id/view_accent"
            android:layout_width="5dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_pill_fill"
            android:backgroundTint="@color/accent_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Sağdaki "Ödendi/Borçlu" rozeti yüzünden ada kalan yer dar; autosize kesilmeyi önler. -->
        <TextView
            android:id="@+id/text_name"
            style="@style/Widget.Rota.AutoSizeItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_xs"
            app:layout_constraintEnd_toStartOf="@id/badge_status"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ahmet Soylu" />

        <TextView
            android:id="@+id/badge_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/success_green_soft"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/success_green"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ödendi" />

        <TextView
            android:id="@+id/text_phone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="1dp"
            android:alpha="0.7"
            android:drawablePadding="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_phone"
            app:drawableTint="@color/accent_blue"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_name"
            tools:text="0555 111 22 33" />

        <LinearLayout
            android:id="@+id/row_amounts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toBottomOf="@id/text_phone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:text="@string/ledger_agreed"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_agreed"
                    style="@style/Widget.Rota.AutoSizeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="10sp"
                    tools:text="₺ 38.700" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:text="@string/ledger_collected"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_collected"
                    style="@style/Widget.Rota.AutoSizeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_green"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="10sp"
                    tools:text="₺ 20.000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:text="@string/ledger_remaining"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_remaining"
                    style="@style/Widget.Rota.AutoSizeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_red"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="10sp"
                    tools:text="₺ 18.700" />
            </LinearLayout>
        </LinearLayout>

        <!-- Collected progress -->
        <LinearLayout
            android:id="@+id/progress_bar"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_track"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toBottomOf="@id/row_amounts">

            <View
                android:id="@+id/bar_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:background="@drawable/bg_pill_fill"
                android:backgroundTint="@color/accent_green" />

            <View
                android:id="@+id/bar_empty"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_s"
            android:alpha="0.7"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toBottomOf="@id/progress_bar"
            tools:text="Anlaşılan tarih: 12.05.2026" />

        <TextView
            android:id="@+id/text_overdue_notice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:text="@string/ledger_overdue_notice"
            android:textColor="@color/accent_red"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toBottomOf="@id/text_date"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
