<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Root namespace style for dot-separated widget styles -->
    <style name="Widget" />

    <!-- Base namespace style for dot-separated styles (prevents implicit parent lookup errors) -->
    <style name="Widget.Rota" />

    <style name="Widget.Rota.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/brand_red</item>
    </style>

    <style name="Widget.Rota.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="strokeColor">@color/outline_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Widget.Rota.Card">
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="strokeColor">@color/outline_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>

    <style name="Widget.Rota.TotalCard" parent="Widget.Rota.Card">
        <item name="cardBackgroundColor">@color/brand_red</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Material3 elevated yüzeyleri elevationOverlayColor (= colorPrimary, brand_red) ile
         tintler; bu yüzden yükseltilmiş beyaz kartlar hafif kırmızı görünür. Bu overlay
         tinti kapatır, kart saf beyaz kalır. -->
    <style name="ThemeOverlay.Rota.PlainSurface" parent="">
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Widget.Rota.BottomNav.ActiveIndicator" parent="">
        <item name="android:color">@color/brand_blue_soft</item>
        <item name="android:height">42dp</item>
        <item name="android:width">84dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Rota.Pill</item>
    </style>

    <style name="ShapeAppearance.Rota.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.Rota.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.Rota.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">9sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.Rota.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">9sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.Rota.Tab.Small" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!--
        Otomatik küçülen (autosize) yazı stilleri.

        Dar ekranlarda başlıklar ve isimler yan komşuları (arama kutusu, durum rozeti, segment
        düğmeleri) yüzünden sıkışıp "..." ile kesiliyordu. Bu stiller yazıyı önce kademeli
        küçültür, ancak min. boyutta bile sığmazsa kesme devreye girer.

        NOT: autoSize* niteliklerinin `app:` (AppCompat) sürümü kullanılır; `android:` sürümü
        yalnızca API 26+'da çalışır, uygulamanın minSdk'sı 24. Ayrıca autosize'ın çalışması için
        TextView genişliği 0dp/match_parent olmalıdır (wrap_content'te etkisizdir).
    -->
    <!-- Ekran başlığı: "Tekliflerim", "Alacak Defteri", "Malzemeler" -->
    <style name="Widget.Rota.AutoSizeTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">14sp</item>
        <item name="autoSizeMaxTextSize">22sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- Kart/satır başlığı: müşteri adı, malzeme adı -->
    <style name="Widget.Rota.AutoSizeItemTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">16sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- Rakam/tutar alanları: "₺ 1.250.000" gibi uzun tutarlar kesilmesin -->
    <style name="Widget.Rota.AutoSizeAmount" parent="">
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">17sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- A single "✓ feature" row on the subscription screen. -->
    <style name="SubFeatureRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
        <item name="android:drawableStart">@drawable/ic_check_sub</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

</resources>


