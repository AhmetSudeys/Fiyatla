<resources>
    <dimen name="space_xs">8dp</dimen>
    <dimen name="space_s">12dp</dimen>
    <dimen name="space_m">16dp</dimen>
    <dimen name="space_l">24dp</dimen>

    <dimen name="radius_m">16dp</dimen>
    <dimen name="radius_l">24dp</dimen>
    <dimen name="radius_pill">28dp</dimen>

    <!--
        Malzeme tablosu sütunları: item_material_row ile fragment_materials_page /
        fragment_quote_materials_page başlıklarının hizalı kalması için ortak.

        BURADAKİ DEĞERLER DAR CİHAZLAR İÇİNDİR (< 400dp genişlik). Sabit genişlikli üç sayı
        sütunu, satırın çoğunu yiyip malzeme adına çok az yer bıraktığı için adlar "..." ile
        kesiliyordu; dar ekranda sütunlar ve sayı punto'su küçültülür. Geniş cihazlardaki ferah
        değerler values-w400dp/dimens.xml içindedir.

        material_col_price, seçilen punto'da en uzun tutarı ("42.000,00 ₺") tam alacak şekilde
        ölçülmüştür; punto ile genişliği birlikte değiştirin.
    -->
    <dimen name="material_col_qty">38dp</dimen>
    <dimen name="material_col_price">64dp</dimen>
    <dimen name="material_col_total">70dp</dimen>
    <dimen name="material_col_gap">6dp</dimen>
    <dimen name="material_row_padding_h">10dp</dimen>
    <!-- Sayı sütunlarının normal punto'su; yalnızca sütuna sığmayan çok büyük tutarlarda
         autosize ile küçülür (bkz. item_material_row), böylece hiçbir değer kesilmez. -->
    <dimen name="material_col_text">11sp</dimen>
    <!-- Malzeme adının punto'su; ad autosize değil, gerekirse alt satıra sarar. -->
    <dimen name="material_name_text">13sp</dimen>
    <!--
        Tablo başlıkları ("Malzeme / Miktar / Fiyat / Tutar"). Sabit 12sp iken dar cihazlarda
        "Miktar" 34dp'lik sütuna sığmayıp "Mikt..." diye kesiliyordu; başlıklar artık
        ellipsize edilmez, autosize ile 8sp'ye kadar küçülüp HER ZAMAN tam görünür.
    -->
    <dimen name="material_header_text">12sp</dimen>
</resources>


