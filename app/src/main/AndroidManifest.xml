<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DogalgazTeklif"
        tools:targetApi="31">
        <!--
            Simgenin altındaki yazı uygulamanın DEĞİL, başlatıcı activity'nin label'ından gelir.
            Buraya kısa adı veriyoruz ki launcher'da yarım kalmasın; application android:label
            (tam ad) Ayarlar ve izin diyaloglarında olduğu gibi kalır.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name_launcher"
            android:theme="@style/Theme.DogalgazTeklif.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.onboarding.BackupDownloadActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.DogalgazTeklif.Invisible" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>